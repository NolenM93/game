; Lantern Hollow — spooky 3D graveyard defense
config_version=5

[application]
config/name="Lantern Hollow"
config/description="Hold the last lantern. Build fences. Pop cartoon zombies. A spooky wave defense for kids."
config/version="1.0.0"
config/tags=PackedStringArray("3d", "kids", "halloween")
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]
Settings="*res://scripts/autoload/settings.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
Catalog="*res://scripts/autoload/catalog.gd"
Art="*res://scripts/autoload/art.gd"
AudioDirector="*res://scripts/autoload/audio_director.gd"
Juice="*res://scripts/autoload/juice.gd"
Game="*res://scripts/autoload/game.gd"

[debug]
file_logging/enable_file_logging=true

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[physics]
common/physics_ticks_per_second=60
3d/default_gravity=22.0

[rendering]
renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.05, 0.06, 0.1, 1)
textures/canvas_textures/default_texture_filter=1
