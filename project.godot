; Lantern Hollow — spooky 3D graveyard defense
config_version=5

[application]
config/name="Lantern Hollow"
config/description="Hold the last lantern. Build fences. Pop cartoon zombies. A spooky wave defense for kids."
config/version="1.0.0"
config/tags=PackedStringArray("3d", "kids", "halloween")
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]
Settings="*res://scripts/autoload/settings.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
Catalog="*res://scripts/autoload/catalog.gd"
Art="*res://scripts/autoload/art.gd"
AudioDirector="*res://scripts/autoload/audio_director.gd"
Juice="*res://scripts/autoload/juice.gd"
Game="*res://scripts/autoload/game.gd"

[debug]
file_logging/enable_file_logging=true

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[physics]
common/physics_ticks_per_second=60
3d/default_gravity=22.0

[rendering]
renderer/rendering_method="forward_plus"
	anti_aliasing/quality/msaa_3d=2
	anti_aliasing/quality/screen_space_aa=1
	anti_aliasing/quality/use_debanding=true
	lights_and_shadows/directional_shadow/size=8192
	lights_and_shadows/directional_shadow/soft_shadow_filter_quality=5
	lights_and_shadows/positional_shadow/soft_shadow_filter_quality=4
	lights_and_shadows/positional_shadow/atlas_size=4096
	environment/ssao/quality=3
	environment/ssil/quality=3
	environment/glow/upscale_mode=1
	environment/volumetric_fog/volume_size=128
	environment/volumetric_fog/volume_depth=96
	environment/volumetric_fog/use_filter=1
	environment/defaults/default_clear_color=Color(0.03, 0.035, 0.05, 1)
	textures/canvas_textures/default_texture_filter=1
	textures/default_filters/anisotropic_filtering_level=4
